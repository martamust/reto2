<!DOCTYPE html>
<html lang="es">
<head>
  <!--Metadatos básicos-->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mi colección - MyMovieSpace</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<!--Ponemos una clase especial en el body para aplicar estilso específicamente-->
<body class="coleccion-body">

  <!--Header para logueado con logout + avatar que viene del json de usuarios-->
  <%- include('partials/main-menu-user.ejs', { user: user }) %>

  <main class="coleccion">
    <h1>MI COLECCIÓN</h1>

     <!--Grid con películasdel usuario-->
    <section class="peliculas-container">
      <div class="peliculas-grid">
        <!--Si el usuario tiene películas, las recorremos y mostramos-->
        <% if (movies && movies.length > 0) { %>
          <% movies.forEach(function(movie) { %>
            <!--Cada película dentro de un article. Portada, título y ver más detalles-->
            <article class="pelicula">
              <img src="<%= movie.imagen_cartel %>" alt="<%= movie.titulo %>">
              <h3><%= movie.titulo %></h3>
              <a href="/pelicula/<%= encodeURIComponent(movie.titulo) %>" class="btn-detalles">
                Ver detalles
              </a>
            </article>

          <% }) %>
        <% } else { %>
          <!--Si el usuario no tiene películas en su colección aparece el mensaje:-->
          <p>No tienes películas en tu colección todavía.</p>
        <% } %>
      </div>
    </section>
  </main>

    <!--Metemos el footer con include-->
  <%- include('partials/footer') %>
</body>


</html>
