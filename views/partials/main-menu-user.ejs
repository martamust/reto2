<header class="header header-logged">
  <div class="logo">
    <a href="/coleccion" class="logo-link">
      <img src="/images/logo.png" class="logo-img" alt="MyMovieSpace">
    </a>
  </div>

  <nav class="nav nav-logged">
    <a href="/contacto" class="help-link">¿Necesitas ayuda?</a>
    <div class="user-menu">
      <div class="user-avatar">
        <img src="<%= user.avatar %>" alt="<%= user.username %>">
      </div>
      <span class="user-name"><%= user.username %></span>
    </div>
    <a href="/logout" class="btn-main">Cerrar sesión</a>
  </nav>
</header>
