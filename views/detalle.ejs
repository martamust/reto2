<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pelicula.titulo %> - MyMovieSpace</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body class="coleccion-body">
  <%- include('partials/main-menu-user.ejs', { user: user }) %>

  <main class="detalle-pelicula">
    <section class="detalle-contenido">
      <div class="detalle-poster">
        <img src="<%= pelicula.imagen_cartel %>" alt="<%= pelicula.titulo %>">
      </div>

      <div class="detalle-info">
        <h1><%= pelicula.titulo %></h1>

        <p class="detalle-meta">
          <span><%= pelicula.generos.join(' · ') %></span><br>
          <span><%= pelicula.año %></span> ·
          <span><%= pelicula.director %></span>
        </p>

        <p class="detalle-sinopsis"><%= pelicula.sinopsis %></p>

        <div class="detalle-tu-copia">
          <h3>Tu copia</h3>

          <% if (copiaUsuario) { %>
            <p>Soporte: <strong><%= copiaUsuario.soporte %></strong></p>
            <p>Estado: <strong><%= copiaUsuario.estado %></strong></p>

            <div class="detalle-botones">
              <a href="/coleccion" class="btn-detalles">Volver a mi colección</a>

              <form action="/pelicula/<%= encodeURIComponent(pelicula.titulo) %>/eliminar"
                    method="post">
                <button type="submit" class="btn-peligro">Eliminar</button>
              </form>
            </div>
          <% } else { %>
            <p>No tienes esta película en tu colección.</p>
            <a href="/coleccion" class="btn-detalles">Volver a mi colección</a>
          <% } %>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
